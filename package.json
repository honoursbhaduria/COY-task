{
  "name": "coy-discover",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node server/index.js",
    "build": "vite build",
    "start": "node server/index.js --production",
    "test": "node --test tests/*.test.js",
    "test:ui": "node tests/browser.mjs",
    "format:check": "prettier --check \"src/*.{js,jsx,css}\" \"server/**/*.js\" \"api/*.js\" \"scripts/*.mjs\" \"tests/*.{js,mjs}\" package.json index.html vercel.json",
    "generate:postgres": "node scripts/generate-postgres.mjs && prettier --write server/postgres/store.js server/postgres/connections.js"
  },
  "dependencies": {
    "@vercel/functions": "^3.11.3",
    "express": "5.1.0",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.3.0",
    "jsqr": "^1.4.0",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@babel/generator": "^8.1.2",
    "@babel/parser": "^8.1.2",
    "@babel/traverse": "^8.1.2",
    "@babel/types": "^8.1.2",
    "playwright": "1.57.0",
    "prettier": "^3.10.1",
    "vite": "^7.3.8"
  },
  "engines": {
    "node": "22.x"
  }
}
