{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": { "api/index.js": { "maxDuration": 60 } },
  "rewrites": [
    { "source": "/session", "destination": "/api" },
    { "source": "/me", "destination": "/api" },
    { "source": "/feed", "destination": "/api" },
    { "source": "/swipe", "destination": "/api" },
    { "source": "/matches", "destination": "/api" },
    { "source": "/profile", "destination": "/api" },
    { "source": "/location", "destination": "/api" },
    { "source": "/photo", "destination": "/api" },
    { "source": "/media/:path*", "destination": "/api" },
    { "source": "/letters/:path*", "destination": "/api" },
    { "source": "/connections/:path*", "destination": "/api" },
    { "source": "/encounters/:path*", "destination": "/api" },
    { "source": "/encounters", "destination": "/api" }
  ]
}
